rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // For the server-side Client SDK (which won't have request.auth), 
    // we need to be careful. However, since the server is trusted, 
    // we can allow writes to 'users' if we trust the API Key hasn't leaked.
    // In a real production app, we would use Firebase Auth on the server.
    
    match /users/{userId} {
      allow read, write: if true; // Temporarily allow for server-side Client SDK
    }

    match /folders/{folderId} {
      allow read, write: if true; // Temporarily allow for server-side Client SDK
    }

    match /files/{fileId} {
      allow read, write: if true; // Temporarily allow for server-side Client SDK
    }

    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
